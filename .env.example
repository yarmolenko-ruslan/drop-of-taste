# Only for the local API. The sign-in code is printed in the API terminal.
API_PORT=3001
APP_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=testset
# Test shop only. Keep the secret in .env, never in browser code or Git.
# YOOKASSA_TEST_SHOP_ID=1522340
# YOOKASSA_TEST_SECRET_KEY=
# Set a long unique password before using the admin panel. If omitted, a temporary one is printed by the API.
# ADMIN_PASSWORD=
# iiko credentials stay only on the API server. Leave them unset until the cafe provides access.
# IIKO_APP_ID=
# IIKO_CLIENT_SECRET=
# IIKO_API_KEY=
# IIKO_ORGANIZATION_ID=
# IIKO_EXTERNAL_MENU_ID=
# IIKO_PRICE_CATEGORY_ID=
